{
  "name": "deepseek-pet",
  "version": "2.7.0",
  "description": "DeepSeek Pet - 你的 DeepSeek API 桌面小管家",
  "author": "kgnb666",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test",
    "build": "electron-builder --win portable nsis --publish never",
    "build:portable": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.deepseekpet.app",
    "productName": "DeepSeekPet",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "chat.html",
      "chat.css",
      "style.css",
      "prices.json",
      "src/**",
      "electron/**",
      "assets/**",
      "!assets/animations/**/*.png",
      "!**/*.md"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "DeepSeekPet-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Pet",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "DeepSeekPet-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
